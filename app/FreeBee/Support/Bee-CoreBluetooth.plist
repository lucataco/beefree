<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Fallback: plain CoreBluetooth scanning with the usual permission prompt.
	     Select it with BEE_PAIRING = CoreBluetooth in the project build settings.
	     AccessorySetupKit and CoreBluetooth scanning are mutually exclusive, so each has its own plist. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>FreeBee connects to your Bee wearable over Bluetooth to show its status and change its settings.</string>
	<key>BeeAppGroup</key>
	<string>$(BEE_APP_GROUP)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).nightly</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).process.*</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>FreeBee transcribes your Bee's recordings on this iPhone.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>processing</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>beekit key file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
